<section class="ww-trust">
  <div class="ww-trust__inner">
    <div>
      <h3>{{ section.settings.t1 | escape }}</h3>
      <p>{{ section.settings.b1 | escape }}</p>
    </div>
    <div>
      <h3>{{ section.settings.t2 | escape }}</h3>
      <p>{{ section.settings.b2 | escape }}</p>
    </div>
    <div>
      <h3>{{ section.settings.t3 | escape }}</h3>
      <p>{{ section.settings.b3 | escape }}</p>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: '/pages/size-guide' }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WW trust",
  "tag": "div",
  "class": "ww-sec",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "Title 1",
      "default": "Tracked shipping"
    },
    {
      "type": "textarea",
      "id": "b1",
      "label": "Body 1",
      "default": "Hong Kong 1–5 business days. UK and US 5–10 business days. Times start when the order is dispatched."
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Title 2",
      "default": "Three countries"
    },
    {
      "type": "textarea",
      "id": "b2",
      "label": "Body 2",
      "default": "We ship to Hong Kong, the United Kingdom, and the United States."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Title 3",
      "default": "Measure twice"
    },
    {
      "type": "textarea",
      "id": "b3",
      "label": "Body 3",
      "default": "Costume refunds are almost always a size miss. Chest behind the front legs, then go up."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Size guide"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "WW trust"
    }
  ]
}
{% endschema %}
